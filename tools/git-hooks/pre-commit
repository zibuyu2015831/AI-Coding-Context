#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Pre-commit Hook for AI Coding Context Framework
用于在 commit 前检查 commit message 格式和 Git 安全规范

功能:
1. 检查 commit message 是否符合 prompt: 格式(可选)
2. 验证 WHAT/WHY/HOW 字段完整性
3. Git 安全检查(保护分支、危险命令)
4. 提供友好的错误提示和修复建议

使用方式:
  python tools/py/install_hooks.py  # 自动安装
  或手动复制到 .git/hooks/pre-commit
"""

import sys
import os
import re
import subprocess
from pathlib import Path

# 添加 tools/py 到路径
TOOLS_DIR = Path(__file__).parent.parent / 'py'
sys.path.insert(0, str(TOOLS_DIR))

try:
    from git_safety import check_current_branch, is_protected_branch
    from commit_quality_scorer import score_commit_message
except ImportError:
    # 如果工具不可用,仅做基础检查
    pass


def get_commit_message():
    """获取当前的 commit message"""
    commit_msg_file = sys.argv[1] if len(sys.argv) > 1 else '.git/COMMIT_EDITMSG'
    
    if not os.path.exists(commit_msg_file):
        return None
    
    with open(commit_msg_file, 'r', encoding='utf-8') as f:
        return f.read().strip()


def check_commit_format(message):
    """检查 commit message 格式"""
    lines = message.split('\n')
    if not lines:
        return False, "Commit message 不能为空"
    
    first_line = lines[0]
    
    # 检查是否使用了结构化格式
    prompt_pattern = r'^(prompt|ai|doc)\([^)]+\):\s*.+'
    if re.match(prompt_pattern, first_line, re.IGNORECASE):
        # 结构化格式,检查 WHAT/WHY/HOW
        full_message = '\n'.join(lines)
        
        has_what = 'WHAT:' in full_message or 'What:' in full_message
        has_why = 'WHY:' in full_message or 'Why:' in full_message
        has_how = 'HOW:' in full_message or 'How:' in full_message
        
        missing = []
        if not has_what:
            missing.append('WHAT')
        if not has_why:
            missing.append('WHY')
        if not has_how:
            missing.append('HOW')
        
        if missing:
            return False, f"缺少必需字段: {', '.join(missing)}"
        
        return True, "格式正确"
    else:
        # 传统格式,给出建议但不阻塞
        return True, "建议使用 prompt(type): 格式以获得更好的文档自动化支持"


def check_git_safety():
    """检查 Git 安全规范"""
    try:
        # 检查当前分支
        result = subprocess.run(
            ['git', 'rev-parse', '--abbrev-ref', 'HEAD'],
            capture_output=True,
            text=True,
            check=True
        )
        current_branch = result.stdout.strip()
        
        # 检查是否为保护分支
        protected_branches = ['main', 'master', 'production']
        if current_branch in protected_branches:
            return False, f"⛔ 禁止在保护分支 '{current_branch}' 直接提交!\n请创建 feature 分支进行开发。"
        
        # 检查分支命名规范
        valid_prefixes = ['feature/', 'bugfix/', 'refactor/', 'hotfix/', 'release/']
        if not any(current_branch.startswith(prefix) for prefix in valid_prefixes):
            return True, f"⚠️ 建议使用规范的分支命名: {', '.join(valid_prefixes)}xxx"
        
        return True, "Git 安全检查通过"
    
    except Exception as e:
        return True, f"Git 安全检查失败: {str(e)}"


def check_complexity():
    """检查复杂度增量"""
    try:
        print("\n🔍 Pre-commit Hook: 检查复杂度增量...")

        # 调用复杂度扫描工具
        import subprocess
        import json
        from pathlib import Path

        # 找到项目根目录
        current = Path.cwd()
        root_dir = None
        while current != current.parent:
            if (current / 'tools').exists():
                root_dir = current
                break
            current = current.parent

        if not root_dir:
            return True, "无法找到项目根目录，跳过复杂度检查"

        # 调用复杂度扫描
        scanner_path = root_dir / 'tools' / 'py' / 'complexity_scanner.py'
        if not scanner_path.exists():
            return True, "复杂度扫描工具不存在，跳过检查"

        result = subprocess.run(
            [sys.executable or 'python3', str(scanner_path), '--since', '1 day ago'],
            capture_output=True,
            text=True,
            timeout=10
        )

        if result.returncode != 0:
            return True, f"复杂度扫描失败: {result.stderr}"

        try:
            data = json.loads(result.stdout)
            risk_assessment = data.get('data', {}).get('risk_assessment', {})
            risks = risk_assessment.get('risks', [])

            high_risks = [r for r in risks if r.get('level') == 'high']

            if high_risks:
                print(f"\n⚠️ 检测到 {len(high_risks)} 个高风险项:")
                for r in high_risks:
                    print(f"   - {r.get('message')}")
                print("\n💡 建议先处理这些问题再提交，或使用: git commit --no-verify 跳过")
                return False, "存在高风险复杂度问题"

            if risks:
                print(f"\nℹ️ 检测到 {len(risks)} 个注意事项:")
                for r in risks:
                    level_color = '🟢' if r.get('level') == 'low' else '🟡'
                    print(f"   {level_color} {r.get('message')}")

            return True, "复杂度检查通过"

        except json.JSONDecodeError:
            return True, "复杂度数据解析失败，跳过检查"

    except Exception as e:
        return True, f"复杂度检查出错: {str(e)}"


def main():
    """主函数"""
    print("🔍 Pre-commit Hook: 检查 commit message...")

    # 获取 commit message
    message = get_commit_message()
    if not message:
        print("❌ 无法读取 commit message")
        return 1

    # 检查格式
    format_ok, format_msg = check_commit_format(message)
    if not format_ok:
        print(f"\n❌ Commit message 格式错误:")
        print(f"   {format_msg}")
        print("\n💡 建议格式:")
        print("   prompt(feature): 一句话描述")
        print("   ")
        print("   WHAT: 做了什么")
        print("   WHY: 为什么做")
        print("   HOW: 怎么做的")
        print("\n💡 快速生成:")
        print("   python tools/py/commit_template_cli.py")
        print("\n⚠️ 如需跳过检查: git commit --no-verify")
        return 1
    elif "建议" in format_msg:
        print(f"\n⚠️ {format_msg}")

    # Git 安全检查
    safety_ok, safety_msg = check_git_safety()
    if not safety_ok:
        print(f"\n{safety_msg}")
        print("\n💡 建议操作:")
        print("   git checkout -b feature/your-feature-name")
        print("   git commit  # 在新分支提交")
        return 1
    elif "建议" in safety_msg or "⚠️" in safety_msg:
        print(f"\n{safety_msg}")

    # 质量评分(如果工具可用)
    try:
        score, breakdown = score_commit_message(message)
        if score < 60:
            print(f"\n⚠️ Commit 质量评分: {score}/100 (建议改进)")
            print("   建议使用 CLI 工具生成高质量 commit:")
            print("   python tools/py/commit_template_cli.py")
        elif score >= 80:
            print(f"\n✅ Commit 质量评分: {score}/100 (优秀!)")
    except:
        pass  # 工具不可用时跳过评分

    # 复杂度检查
    complexity_ok, complexity_msg = check_complexity()
    if not complexity_ok:
        print(f"\n❌ {complexity_msg}")
        return 1

    print("\n✅ Pre-commit 检查通过!")
    return 0


if __name__ == '__main__':
    sys.exit(main())
